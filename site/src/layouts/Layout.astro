---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import data from "../data/today.json";
import { shortDate } from "../lib/format";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Open Analysis — what AI really costs in Australia",
  description = "Daily, independent data on AI models in Australian dollars: what's worth paying for, what's overpriced, and what's hosted in Australia.",
} = Astro.props;

const nav = [
  ["Today", "/"],
  ["Leaderboard", "#leaderboard"],
  ["Best value", "#spread"],
  ["Australia", "#australia"],
  ["Method", "#method"],
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen font-sans text-zinc-100 selection:bg-value selection:text-ink">
    <header class="sticky top-0 z-30 border-b border-line bg-ink/80 backdrop-blur-xl">
      <div class="mx-auto flex h-14 max-w-6xl items-center gap-8 px-5">
        <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
          <span class="grid size-6 place-items-center rounded-md bg-value text-[11px] font-bold text-ink">OA</span>
          Open Analysis
        </a>
        <nav class="hidden items-center gap-6 text-sm text-zinc-400 md:flex">
          {nav.map(([label, href]) => <a href={href} class="transition hover:text-zinc-100">{label}</a>)}
        </nav>
        <div class="ml-auto flex items-center gap-3 text-xs text-zinc-500">
          <span class="relative flex size-2">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-value/60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-value"></span>
          </span>
          <span>Updated {shortDate(data.date)}</span>
          <span class="hidden num sm:inline">A$1 = US${data.fx.aud_usd}</span>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer id="method" class="mt-24 border-t border-line">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 text-sm text-zinc-400 md:grid-cols-3">
        <div>
          <p class="font-semibold text-zinc-100">Open Analysis</p>
          <p class="mt-2 leading-relaxed">
            Independent, daily data on AI models for Australia. Prices in AUD, ex GST, at the RBA rate. We never
            estimate a number a source doesn't give us.
          </p>
        </div>
        <div>
          <p class="font-semibold text-zinc-100">How to read it</p>
          <p class="mt-2 leading-relaxed">
            Intelligence is the Artificial Analysis Intelligence Index. Cost per task is Artificial Analysis's cost to
            run one task of that index. A model is <em>overpriced</em> when another is at least as smart and cheaper.
            "Current" means released in the last {data.current_rule.days} days.
          </p>
        </div>
        <div>
          <p class="font-semibold text-zinc-100">Sources</p>
          <ul class="mt-2 space-y-1">
            {data.attribution.map((a) => (
              <li>
                <a href={a.url} class="text-zinc-300 underline decoration-zinc-700 underline-offset-4 hover:decoration-zinc-300">
                  {a.source}
                </a>
                <span class="text-zinc-500"> — {a.used_for}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
